<?xml version="1.0"?>
<robot name="my_3dof_arm">

  <!-- ===================== -->
  <!--         LINKS         -->
  <!-- ===================== -->

  <!-- Base -->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://my_arm_description/meshes/base_link.stl" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>

  <!-- Rotating base (yaw) + shoulder bracket (your design combines these) -->
  <link name="rotating_base">
    <visual>
      <geometry>
        <mesh filename="package://my_arm_description/meshes/rotating_base.stl" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>

  <!-- Upper arm -->
  <link name="upper_arm_link">
    <visual>
      <geometry>
        <mesh filename="package://my_arm_description/meshes/upper_arm_link.stl" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>

  <!-- Forearm -->
  <link name="forearm_link">
    <visual>
      <geometry>
        <mesh filename="package://my_arm_description/meshes/forearm_link.stl" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>

  <!-- Link 147 (008), parallel bar in the wrist linkage -->
  <link name="link147">
    <visual>
      <geometry>
        <mesh filename="package://my_arm_description/meshes/link147.stl" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>

  <!-- Trialinkfront (009), coupler between forearm and wrist -->
  <link name="trialinkfront">
    <visual>
      <geometry>
        <mesh filename="package://my_arm_description/meshes/trialinkfront.stl" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>

  <!-- 003 VArm, diagonal bar between rotating_base and left side mechanism -->
  <link name="VArm">
    <visual>
      <geometry>
        <mesh filename="package://my_arm_description/meshes/VArm.stl" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>

  <!-- 004 link135_left, vertical linkage up to the forearm -->
  <link name="link135_left">
    <visual>
      <geometry>
        <mesh filename="package://my_arm_description/meshes/link135_left.stl" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>

  <!-- 005 link135_right, driven link on the right side -->
  <link name="link135_right">
    <visual>
      <geometry>
        <mesh filename="package://my_arm_description/meshes/link135_right.stl" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>

  <!-- 007 trialink, right-side top link connecting to upper arm -->
  <link name="trialink">
    <visual>
      <geometry>
        <mesh filename="package://my_arm_description/meshes/trialink.stl" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>

  <!-- Wrist/palm combo -->
  <link name="wrist_link">
    <visual>
      <geometry>
        <mesh filename="package://my_arm_description/meshes/wrist_link.stl" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>

  <!-- Gripper fingers -->
  <link name="left_finger">
    <visual>
      <geometry>
        <mesh filename="package://my_arm_description/meshes/left_finger.stl" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>

  <link name="right_finger">
    <visual>
      <geometry>
        <mesh filename="package://my_arm_description/meshes/right_finger.stl" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>


  <!-- ===================== -->
  <!--         JOINTS        -->
  <!-- ===================== -->

  <!-- Joint 1: Yaw -->
  <joint name="joint1_yaw" type="revolute">
    <parent link="base_link"/>
    <child link="rotating_base"/>
    <origin xyz="0 0 55" rpy="0 0 -1.5708"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1"/>
  </joint>

  <!-- Joint 2: Shoulder pitch -->
  <joint name="joint2_shoulder" type="revolute">
    <parent link="rotating_base"/>
    <child link="upper_arm_link"/>
    <origin xyz="4.73922 -0.319788 43" rpy="0 0 1.5708"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>

  <!-- Joint 3: Elbow pitch -->
  <joint name="joint3_elbow" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 15.25 135" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="10" velocity="1"/>
  </joint>

  <!-- !!! Joint: forearm to link147 (008).
       This is a passive joint that mimics the elbow motion. -->
  <joint name="joint_link147" type="revolute">
    <parent link="forearm_link"/>
    <child link="link147"/>
    <!-- TODO: adjust origin to the actual pivot of link147 on the forearm -->
    <origin xyz="106.09851 -20 28.385964" rpy="1.5708 3.13689 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="1" velocity="2.0"/>
    <!-- Link147 angle follows the elbow joint (tune multiplier/sign as needed) -->
    <mimic joint="joint3_elbow" multiplier="1.0" offset="0.0"/>
  </joint>

  <!-- !!! Joint: forearm to trialinkfront (009 coupler).
       Passive joint that mimics link147. -->
  <joint name="joint_trialinkfront" type="revolute">
    <parent link="forearm_link"/>
    <child link="trialinkfront"/>
    <!-- Start with the original forearm-wrist offset here -->
    <origin xyz="186.34497 2 -6.222006" rpy="0 0 1.5708"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="1" velocity="2.0"/>
    <!-- Coupler angle follows link147 joint (tune multiplier/sign) -->
    <mimic joint="joint_link147" multiplier="1.0" offset="0.0"/>
  </joint>

  <!-- !!! Joint 4: Wrist pitch, driven by the linkage (via trialinkfront). -->
  <joint name="joint4_wrist_pitch" type="revolute">
    <parent link="trialinkfront"/>
    <child link="wrist_link"/>
    <!-- Local offset between trialinkfront and wrist; start with identity -->
    <origin xyz="-8.7 -6.020705 -2.907509" rpy="0 0 -1.5708"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="1" velocity="2.0"/>
    <!-- Wrist angle follows the coupler joint.
         You can tune multiplier/offset to match the real wrist behavior. -->
    <mimic joint="joint_trialinkfront" multiplier="1.0" offset="0.0"/>
  </joint>

  <!-- !!! Joint: rotating_base to VArm (003).
       Passive visual linkage, roughly following shoulder. -->
  <joint name="joint_VArm" type="revolute">
    <parent link="rotating_base"/>
    <child link="VArm"/>
    <!-- TODO: set this to the actual pivot of VArm on the rotating base -->
    <origin xyz="-11.75 0 43.25" rpy="1.5708 0 -1.5708"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="1" velocity="2.0"/>
    <!-- Let VArm roughly mimic the shoulder motion (tune as needed) -->
    <mimic joint="joint2_shoulder" multiplier="1.0" offset="0.0"/>
  </joint>

  <!-- !!! Joint: forearm to link135_left (004).
       Passive vertical bar up to forearm tip, mimicking elbow. -->
  <joint name="joint_link135_left" type="revolute">
    <parent link="forearm_link"/>
    <child link="link135_left"/>
    <!-- TODO: set to the pivot where 004 attaches near the forearm end -->
    <origin xyz="-56.999726 6.25 -67.5" rpy="-1.5708 1.5708 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="1" velocity="2.0"/>
    <mimic joint="joint3_elbow" multiplier="1.0" offset="0.0"/>
  </joint>

  <!-- !!! Joint: rotating_base to link135_right (005).
       Driven link on the right; here we mimic elbow for visualization.
       (In hardware, this might actually be the actuated bar.) -->
  <joint name="joint_link135_right" type="revolute">
    <parent link="rotating_base"/>
    <child link="link135_right"/>
    <!-- TODO: pivot location on the rotating base -->
    <origin xyz="25 -37.967649 130.69" rpy="1.5708 1.5708 1.5708"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="1" velocity="2.0"/>
    <!-- For now, let it follow elbow; later you can remap this if you
         want a more physically faithful driver. -->
    <mimic joint="joint3_elbow" multiplier="1.0" offset="0.0"/>
  </joint>

  <!-- !!! Joint: upper_arm to trialink (007).
       Top right link that ties into the linkage loop; we let it mimic elbow. -->
  <joint name="joint_trialink" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="trialink"/>
    <!-- TODO: set to the actual pivot where 007 attaches near the elbow -->
    <origin xyz="0 -10.25 135" rpy="0 -0.1109 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="1" velocity="2.0"/>
    <mimic joint="joint3_elbow" multiplier="1.0" offset="0.0"/>
  </joint>

  <!-- Gripper: actuated finger -->
  <joint name="left_finger_joint" type="revolute">
    <parent link="wrist_link"/>
    <child link="left_finger"/>
    <origin xyz="8.52312 9.05 -3.23983" rpy="-1.5708 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.02" effort="3" velocity="1"/>
  </joint>

  <!-- Gripper: mimic finger -->
  <joint name="right_finger_joint" type="revolute">
    <parent link="wrist_link"/>
    <child link="right_finger"/>
    <origin xyz="8.52312 -9.05 -0.239902" rpy="1.5708 0 0"/>
    <axis xyz="0 1 0"/>
    <mimic joint="left_finger_joint" multiplier="-1.0" offset="0.0"/>
    <limit lower="-0.02" upper="0.0" effort="3" velocity="1"/>
  </joint>

</robot>

